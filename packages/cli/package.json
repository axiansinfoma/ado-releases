{
  "name": "@ado-releases/cli",
  "version": "0.1.0",
  "description": "Command line for ado-releases: generate notes, publish and backfill releases to an Azure DevOps wiki.",
  "license": "MPL-2.0",
  "type": "module",
  "bin": {
    "ado-releases": "dist/cli.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ado-releases/core": "0.1.0"
  }
}

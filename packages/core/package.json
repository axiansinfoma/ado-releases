{
  "name": "@ado-releases/core",
  "version": "0.1.0",
  "description": "Release model, release-notes generation and wiki store for ado-releases. Runs in Node and in the browser (fetch only).",
  "license": "MPL-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  }
}

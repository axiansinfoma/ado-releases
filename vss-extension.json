{
  "manifestVersion": 1,
  "id": "ado-releases",
  "name": "Releases",
  "version": "0.2.5",
  "publisher": "AxiansInfoma",
  "description": "GitHub-style releases for Azure Repos: release notes from merged pull requests, release pages in the project wiki and a Renovate-compatible releases.json per package.",
  "public": false,
  "categories": ["Azure Repos", "Azure Pipelines"],
  "icons": { "default": "images/extension-icon.png" },
  "screenshots": [
    { "path": "images/screenshots/releases-list.png" },
    { "path": "images/screenshots/draft-release.png" },
    { "path": "images/screenshots/wiki-package-page.png" },
    { "path": "images/screenshots/pipeline-task.png" }
  ],
  "tags": ["releases", "release notes", "changelog", "renovate", "wiki"],
  "targets": [{ "id": "Microsoft.VisualStudio.Services" }],
  "scopes": ["vso.code_write"],
  "content": {
    "details": { "path": "README.md" },
    "license": { "path": "LICENSE" }
  },
  "files": [
    { "path": "packages/task/dist/PublishReleaseV0" },
    { "path": "packages/hub/dist", "addressable": true, "packagePath": "hub" }
  ],
  "contributions": [
    {
      "id": "publish-release-task",
      "type": "ms.vss-distributed-task.task",
      "targets": ["ms.vss-distributed-task.tasks"],
      "properties": { "name": "packages/task/dist/PublishReleaseV0" }
    },
    {
      "id": "releases-hub",
      "type": "ms.vss-web.hub",
      "description": "Releases of the current Git repository: list, draft, generate notes, publish, edit and delete.",
      "targets": ["ms.vss-code-web.code-hub-group"],
      "properties": {
        "name": "Releases",
        "uri": "hub/releases.html",
        "iconName": "Rocket",
        "order": 55
      }
    }
  ]
}
